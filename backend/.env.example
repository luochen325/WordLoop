# 大模型：DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 文生图：阿里云百炼（DashScope），与 DeepSeek Key 不同
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# 推荐：qwen-image-3.0-pro（旗舰，1K 0.25 元/张）
# 可选：qwen-image-3.0（0.18 元/张，更快）、qwen-image-plus（0.2 元/张）
IMAGE_MODEL=qwen-image-3.0-pro
# 1024*1024（1K，0.25 元/张）；2048*2048（2K，0.5 元/张）
IMAGE_SIZE=1024*1024

# auto: 有 Key 就调用真实模型；mock: 强制使用本地模拟数据；real: 强制调用真实模型
AI_MODE=auto
